        </a>
      </div>
      <div class="hnote"><svg><use href="#i-clock"/></svg><span><b>Response time:</b> service requests sent by email are typically answered within 15 days. For anything urgent, calling is usually quicker.</span></div>
    </section>

    <section>
      <h2>Troubleshooting &amp; FAQ</h2>
      <div class="hlist">
        <a class="hrow" href="https://www.letsnosh.io/" target="_blank" rel="noopener"><span class="hico s"><svg><use href="#i-wifi"/></svg></span><span><b>Wi-Fi connectivity</b><em>Connection problems and pairing your Nosh</em></span><svg class="go"><use href="#i-out"/></svg></a>
        <a class="hrow" href="https://www.letsnosh.io/" target="_blank" rel="noopener"><span class="hico s"><svg><use href="#i-sliders"/></svg></span><span><b>App settings</b><em>Personalise salt, spice and oil, and manage your preferences</em></span><svg class="go"><use href="#i-out"/></svg></a>
        <a class="hrow" href="https://www.letsnosh.io/" target="_blank" rel="noopener"><span class="hico s"><svg><use href="#i-tool"/></svg></span><span><b>Routine maintenance</b><em>Keeping your Nosh clean and working well</em></span><svg class="go"><use href="#i-out"/></svg></a>
      </div>
      <p class="hsmall">The official FAQ on the Nosh website covers each of these topics.</p>
    </section>

    <section>
      <h2>Warranty &amp; service</h2>
      <div class="hnote"><svg><use href="#i-shield"/></svg><span>Nosh comes with a standard warranty of up to 2 years. To raise a service request or a warranty claim, email <a href="mailto:hello@euphotic.io">hello@euphotic.io</a> or call <a href="tel:+916366377918">+91 63663 77918</a>.</span></div>
    </section>

    <section>
      <h2>What Nosh Assistant can do</h2>
      <p class="hsmall">Tap an example to try it in the chat.</p>
      <div class="hchips">
        <button type="button" data-q="Find a penne pasta recipe.">Find a recipe</button>
        <button type="button" data-q="I have eggs, onions, tomatoes and rice. Suggest five recipes, no peanuts.">Cook with what I have</button>
        <button type="button" data-q="Take this banana bread recipe and remove eggs.">Swap an ingredient</button>
        <button type="button" data-q="Which 5 recipes have the fewest steps?">Quick recipes</button>
        <button type="button" id="helpUpload">Ask about a document</button>
      </div>
    </section>

    <button class="hback" id="helpBack" type="button"><svg><use href="#i-chat"/></svg>Back to chat</button>
  </div>
</main>


<script>
const $=s=>document.querySelector(s), log=$('#log'), q=$('#q');
const HELP=%HELP%;
const ico=n=>`<svg><use href="#i-${n}"/></svg>`;
const esc=t=>String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
const clean=t=>t.replace(/ *\[id: [^\]]+\]/g,'');                 // recipe ids stay in the API, not on screen
let hist=JSON.parse(localStorage.getItem('nosh_hist')||'[]'), first=null, busy=false;

/* ---------------- tiny, safe markdown renderer ---------------- */
function inline(s){
  s=s.replace(/`([^`]+)`/g,'<code>$1</code>')
     .replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>')
     .replace(/(^|[\s(])\*([^*\s][^*]*)\*(?=[\s).,;:!?]|$)/g,'$1<em>$2</em>')
     .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,'<a href="$2" target="_blank" rel="noopener">$1</a>')
     .replace(/&lt;br\s*\/?&gt;/gi,'<br>')
     .replace(/(?:\[|【)(\d{1,2})(?:†[^\]】]*)?(?:\]|】)/g,'<sup class="cite">$1</sup>')
     .replace(/\[SQL\]/g,'<sup class="cite sql">SQL</sup>');
  return s;
}
function md(src){
  src=clean(src).replace(/\r/g,'');
  const blocks=[]; src=src.replace(/```(\w*)\n([\s\S]*?)```/g,(m,l,c)=>{blocks.push(c);return `\u0000${blocks.length-1}\u0000`});
  const lines=esc(src).split('\n'); let out='', i=0;
  const flushP=p=>{ if(p.length) out+='<p>'+inline(p.join('<br>'))+'</p>'; };
  let para=[];
  while(i<lines.length){
    const ln=lines[i], t=ln.trim();
    if(!t){ flushP(para); para=[]; i++; continue; }
    let m;
    if(/^\u0000\d+\u0000$/.test(t)){ flushP(para); para=[]; out+='<pre><code>'+esc(blocks[+t.slice(1,-1)])+'</code></pre>'; i++; continue; }
    if(m=t.match(/^(#{1,4})\s+(.*)$/)){ flushP(para); para=[]; out+=`<h${m[1].length+2}>${inline(m[2])}</h${m[1].length+2}>`; i++; continue; }
    if(/^\|.*\|$/.test(t) && i+1<lines.length && /^\|?\s*:?-{2,}/.test(lines[i+1].trim())){
      flushP(para); para=[];
      const row=l=>l.trim().replace(/^\||\|$/g,'').split('|').map(c=>c.trim());
      const head=row(t); i+=2; let body='';
      while(i<lines.length && /^\|.*\|$/.test(lines[i].trim())){ body+='<tr>'+row(lines[i]).map(c=>`<td>${inline(c)}</td>`).join('')+'</tr>'; i++; }
      out+=`<div class="tw"><table><thead><tr>${head.map(c=>`<th>${inline(c)}</th>`).join('')}</tr></thead><tbody>${body}</tbody></table></div>`; continue;
    }
    if(/^([-*•])\s+/.test(t)){ flushP(para); para=[]; let li='';
      while(i<lines.length && /^\s*([-*•])\s+/.test(lines[i])){ li+='<li>'+inline(lines[i].trim().replace(/^([-*•])\s+/,''))+'</li>'; i++; }
      out+='<ul>'+li+'</ul>'; continue; }
    if(/^\d+[.)]\s+/.test(t)){ flushP(para); para=[]; const start=parseInt(t,10); const items=[];
      while(i<lines.length){
        const L=lines[i];
        if(/^\s*\d+[.)]\s+/.test(L)){ items.push({h:inline(L.trim().replace(/^\d+[.)]\s+/,'')),sub:[]}); i++; }
        else if(items.length && /^\s*([-*•])\s+/.test(L)){ items[items.length-1].sub.push(inline(L.trim().replace(/^([-*•])\s+/,''))); i++; }   // bullets under a step belong to that step
        else if(items.length && !L.trim() && i+1<lines.length && /^\s*(\d+[.)]|[-*•])\s+/.test(lines[i+1])){ i++; }                          // blank line inside one list
        else break;
      }
      out+=`<ol start="${start}">`+items.map(x=>'<li>'+x.h+(x.sub.length?'<ul>'+x.sub.map(y=>'<li>'+y+'</li>').join('')+'</ul>':'')+'</li>').join('')+'</ol>'; continue; }
    if(/^&gt;\s?/.test(t)){ flushP(para); para=[]; let b=[];
      while(i<lines.length && /^\s*&gt;\s?/.test(lines[i])){ b.push(lines[i].trim().replace(/^&gt;\s?/,'')); i++; }
      out+='<blockquote>'+inline(b.join('<br>'))+'</blockquote>'; continue; }
    if(/^(-{3,}|\*{3,})$/.test(t)){ flushP(para); para=[]; out+='<hr>'; i++; continue; }
    para.push(t); i++;
  }
  flushP(para); return out;
}

/* ---------------- chat rows ---------------- */
/* Follow the answer as it streams, but never scroll past the FIRST line of a long answer, and stop following as soon as the user scrolls. */
let curRow=null, follow=true;
function scroll(force){
  if(!force && !follow) return updJump();
  const max=log.scrollHeight-log.clientHeight;
  const top=curRow?Math.max(0,curRow.offsetTop-14):max;
  log.scrollTop=Math.min(max,top);
  updJump();
}
function updJump(){ $('#jump').classList.toggle('on', log.scrollHeight-log.scrollTop-log.clientHeight>140) }
['wheel','touchmove'].forEach(e=>log.addEventListener(e,()=>{follow=false},{passive:true}));
log.addEventListener('keydown',e=>{ if(['PageUp','ArrowUp','Home'].includes(e.key)) follow=false });
log.addEventListener('scroll',updJump,{passive:true});
$('#jump').onclick=()=>{ log.scrollTo({top:log.scrollHeight,behavior:'smooth'}); setTimeout(updJump,400) };
function botRow(inner){const r=document.createElement('div');r.className='row';
  r.innerHTML=`<div class="avatar"><svg><use href="#flame"/></svg></div><div class="stack">${inner}</div>`;log.appendChild(r);scroll();return r}
function meRow(t,files){const r=document.createElement('div');r.className='row me';r.innerHTML=`<div class="bubble">${esc(t)}</div>`;log.appendChild(r);scroll()}
function chips(list){const d=document.createElement('div');d.className='chips';
  list.forEach(([i,t,msg])=>{const b=document.createElement('button');b.className='chip';b.type='button';b.innerHTML=ico(i)+esc(t);b.onclick=()=>msg===':upload'?$('#file').click():send(msg||t);d.appendChild(b)});
  log.appendChild(d);scroll()}
const STARTERS=[['search','Find a quick recipe','Which 5 recipes have the fewest steps?'],['pot','Match my ingredients','I have eggs, onions, tomatoes and rice. Suggest five recipes.'],['sliders','Swap an ingredient','Take this banana bread recipe and remove eggs.']];

function welcome(){
  log.innerHTML=''; curRow=null; follow=true;
  botRow(`<div class="bubble"><b>Hello! I'm Nosh.</b><br>Your kitchen companion for delicious, personalized meals. Ask me about recipes, upload a document to dig into, or just chat.</div>`);
  chips(STARTERS);
}

function cardHTML(c){
  const m=c.meta.map((x,i)=>`<span>${ico(i==0?'list':(/free$/.test(x)?'leaf':'star'))}${esc(x)}</span>`).join('<em></em>');
  return `<div class="card" data-i="${c.index}"><img src="${c.image}" alt="" loading="lazy"><div class="t">${esc(c.title)}</div><div class="m">${m}</div>${c.extra?`<div class="x">${esc(c.extra)}</div>`:''}</div>`;
}

/* ---------------- sending + streaming ---------------- */
async function send(text){
  if(busy||!text) return; busy=true; $('.send').disabled=true;
  document.querySelectorAll('.chips').forEach(c=>c.remove());
  follow=true; curRow=null; meRow(text); if(!first){first=text}
  const row=botRow('<div class="bubble md"><div class="typing"><i></i><i></i><i></i></div></div>');
  curRow=row; scroll(true);
  const stack=row.querySelector('.stack'), bubble=row.querySelector('.bubble');
  let acc='', cards=null, details='', route='', raf=0, sources=null;
  const paint=()=>{raf=0; bubble.innerHTML=md(acc)||'<div class="typing"><i></i><i></i><i></i></div>'; scroll()};
  const on=ev=>{
    if(ev.t==='route') route=ev.route;
    else if(ev.t==='delta'){acc+=ev.x; if(!raf) raf=requestAnimationFrame(paint)}
    else if(ev.t==='cards'){cards=ev.cards}      // shown only after the written answer has finished streaming
    else if(ev.t==='sources'){sources=ev.items}
    else if(ev.t==='done'){details=ev.details||''}
  };
  try{
    const res=await fetch('/api/chat/stream',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:text})});
    const rd=res.body.getReader(), dec=new TextDecoder(); let buf='';
    for(;;){const {value,done}=await rd.read(); if(done)break; buf+=dec.decode(value,{stream:true});
      let k; while((k=buf.indexOf('\n'))>=0){const line=buf.slice(0,k); buf=buf.slice(k+1); if(line.trim()){try{on(JSON.parse(line))}catch(e){}}}}
  }catch(e){ acc+=(acc?'\n\n':'')+'Sorry, I lost the connection to the server. Please try again.'; }
  if(raf) cancelAnimationFrame(raf); paint();
  if(!acc.trim()) bubble.innerHTML='<p>Sorry, I could not come up with an answer to that.</p>';
  if(sources&&sources.length){const s=document.createElement('div'); s.className='sources';
    s.innerHTML='<span>Sources</span>'+sources.map(x=>`<em>${ico('doc')}${esc(x.name)}${x.label?' · '+esc(x.label):''}</em>`).join(''); stack.appendChild(s)}
  if(cards&&cards.length){                       // chat text first, then the recipe photos
    const d=document.createElement('div'); d.className='cards'; d.innerHTML=cards.map(cardHTML).join(''); stack.appendChild(d);
    const n=document.createElement('div'); n.className='note'; n.textContent='Photos are illustrative - the recipe dataset has no pictures.'; stack.appendChild(n);
    d.querySelectorAll('.card').forEach(el=>el.onclick=()=>send('show the ingredients and instructions of #'+el.dataset.i)); scroll();
  }
  if(cards&&cards.length) chips([['search','Show me more','more'],['sliders','Make it dairy-free','I cannot have dairy.'],['pot','Swap an ingredient','Take this recipe and remove eggs.']]);
  busy=false; $('.send').disabled=false; scroll(); updJump(); q.focus();
}

/* ---------------- documents / attachments ---------------- */
const FT={pdf:['PDF','pdf'],docx:['DOC','doc'],doc:['DOC','doc'],xlsx:['XLS','xls'],xlsm:['XLS','xls'],csv:['CSV','xls'],tsv:['TSV','xls'],txt:['TXT','txt'],md:['MD','txt'],rst:['TXT','txt'],log:['LOG','txt'],json:['JSON','json'],jsonl:['JSON','json'],html:['HTML','html'],htm:['HTML','html']};
const ftype=n=>FT[(n.split('.').pop()||'').toLowerCase()]||['FILE','txt'];
const MAXB=40*1024*1024, DEFAULT_PH=q.placeholder;
const fmtSize=b=>b<1024?b+' B':b<1048576?(b/1024).toFixed(b<10240?1:0)+' KB':(b/1048576).toFixed(1)+' MB';
const docMeta=d=>fmtSize(d.size||0)+' · '+(d.kind==='table'?`${(d.rows||0).toLocaleString()} rows`:`${d.chunks} section${d.chunks===1?'':'s'}`);
let docs=[], pending=[], pid=0;

function renderDocs(){
  const box=$('#docs'); box.innerHTML='';
  docs.forEach(d=>{const [lab,cls]=ftype(d.name); const c=document.createElement('div'); c.className='dchip'; c.title=d.name;
    c.innerHTML=`<span class="ft ${cls}">${lab}</span><span class="dtxt"><b>${esc(d.name)}</b><i>${esc(docMeta(d))}</i></span><button class="x" type="button" aria-label="Remove ${esc(d.name)}">&times;</button>`;
    c.querySelector('.x').onclick=async()=>{c.style.opacity='.5'; await fetch('/api/docs/delete',{method:'POST',body:JSON.stringify({id:d.id})}); loadDocs()};
    box.appendChild(c)});
  pending.forEach(p=>{const [lab,cls]=ftype(p.name); const c=document.createElement('div');
    c.className='dchip '+(p.state==='err'?'err':p.state==='read'?'read':''); c.dataset.pid=p.id; c.title=p.name;
    const sub=p.state==='err'?p.msg:p.state==='read'?'Reading and indexing...':`Uploading ${p.pct}%`;
    c.innerHTML=`<span class="ft ${cls}">${lab}</span><span class="dtxt"><b>${esc(p.name)}</b><i>${esc(sub)}</i></span>`
      +(p.state==='err'?'<button class="x" type="button" aria-label="Dismiss">&times;</button>':`<span class="bar"><u style="width:${p.state==='read'?40:p.pct}%"></u></span>`);
    const x=c.querySelector('.x'); if(x) x.onclick=()=>{pending=pending.filter(z=>z!==p); renderDocs()};
    box.appendChild(c)});
  const total=docs.length+pending.length;
  box.style.display=total?'flex':'none';
  $('#composer').classList.toggle('has-docs',total>0);
  const cnt=$('#attach .cnt'); cnt.hidden=!docs.length; cnt.textContent=docs.length; $('#attach').classList.toggle('on',docs.length>0);
  q.placeholder=docs.length?(docs.length===1?`Ask about ${docs[0].name}...`:`Ask about your ${docs.length} documents...`):DEFAULT_PH;
}
async function loadDocs(){try{const r=await fetch('/api/docs'); docs=(await r.json()).docs; renderDocs()}catch(e){}}

/* XHR (not fetch) so the tile can show real upload progress */
function sendFile(f){
  return new Promise(resolve=>{
    const p={id:++pid,name:f.name,state:'up',pct:0}; pending.push(p); renderDocs();
    const fail=m=>{p.state='err'; p.msg=m; renderDocs(); setTimeout(()=>{pending=pending.filter(z=>z!==p); renderDocs()},9000); resolve({error:m})};
    if(f.size>MAXB) return fail('Larger than 40 MB');
    if(!f.size) return fail('The file is empty');
    const x=new XMLHttpRequest(); x.open('POST','/api/upload'); x.setRequestHeader('X-Filename',encodeURIComponent(f.name));
    x.upload.onprogress=e=>{ if(e.lengthComputable){ p.pct=Math.round(e.loaded/e.total*100);
      const u=document.querySelector(`.dchip[data-pid="${p.id}"]`); if(u){u.querySelector('u').style.width=p.pct+'%'; u.querySelector('i').textContent='Uploading '+p.pct+'%'} } };
    x.upload.onload=()=>{p.state='read'; renderDocs()};
    x.onerror=()=>fail('Upload failed - is the server running?');
    x.onload=()=>{ let j={}; try{j=JSON.parse(x.responseText)}catch(e){}
      if(j.doc){ pending=pending.filter(z=>z!==p); resolve({doc:j.doc}) } else fail((j.error||'Upload failed').replace(/^I couldn't read [^:]+: /,'').replace(/\.$/,'')) };
    x.send(f);
  });
}
async function uploadFiles(files){
  curRow=null; follow=true;
  for(const f of files){
    const res=await sendFile(f); await loadDocs();
    document.querySelectorAll('.chips').forEach(c=>c.remove());
    if(res.error){ botRow(`<div class="bubble">${md(`I couldn't add **${f.name}**: ${res.error}.`)}</div>`); continue }
    const d=res.doc, what=d.kind==='table'?`${d.rows.toLocaleString()} rows`:`${d.chunks} section${d.chunks===1?'':'s'}`;
    botRow(`<div class="bubble">${md(`I've read **${d.name}** (${what}). Ask me anything about it.`+(d.warnings.length?'\n\n'+d.warnings.map(w=>'> '+w).join('\n'):''))}</div>`);
    chips(d.kind==='table'?[['search','What does this data contain?','What does '+d.name+' contain? Give me a quick overview.'],['sliders','Quick analysis','Give me a quick analysis of '+d.name+'.']]
                         :[['search','Summarize it','Summarize '+d.name+' in a few bullet points.'],['pot','Key points','What are the key points in '+d.name+'?']]);
  }
}
$('#attach').onclick=()=>$('#file').click();
$('#file').onchange=e=>{uploadFiles([...e.target.files]); e.target.value=''};
let dragDepth=0;
document.addEventListener('dragenter',e=>{ if([...(e.dataTransfer?.types||[])].includes('Files')){ e.preventDefault(); dragDepth++; $('#drop').classList.add('on') } });
document.addEventListener('dragover',e=>{ if([...(e.dataTransfer?.types||[])].includes('Files')) e.preventDefault() });
document.addEventListener('dragleave',e=>{ dragDepth=Math.max(0,dragDepth-1); if(!dragDepth) $('#drop').classList.remove('on') });
document.addEventListener('drop',e=>{ e.preventDefault(); dragDepth=0; $('#drop').classList.remove('on'); if(e.dataTransfer&&e.dataTransfer.files.length) uploadFiles([...e.dataTransfer.files]) });
document.addEventListener('paste',e=>{ const fs=e.clipboardData&&e.clipboardData.files; if(fs&&fs.length){ e.preventDefault(); uploadFiles([...fs]) } });

/* ---------------- history / chrome ---------------- */
function saveHist(){ if(first){hist=[first,...hist.filter(h=>h!==first)].slice(0,12);localStorage.setItem('nosh_hist',JSON.stringify(hist));renderHist()} first=null}
function renderHist(){const ul=$('#histList');ul.innerHTML='';
  if(!hist.length){ul.innerHTML='<li class="empty">No chats yet</li>';return}
  hist.forEach(h=>{const li=document.createElement('li');li.textContent=h;li.title=h;li.onclick=()=>{showChat(); newChat(h)};ul.appendChild(li)})}
async function newChat(replay){
  saveHist(); await fetch('/api/reset',{method:'POST',body:'{}'}); welcome(); if(replay)send(replay)}

$('#f').onsubmit=e=>{e.preventDefault();const t=q.value.trim();if(t){q.value='';send(t)}};
$('#new').onclick=()=>{showChat(); newChat()};
$('#histBtn').onclick=()=>$('#hist').classList.toggle('open');
window.addEventListener('beforeunload',saveHist);
/* ---------------- views: chat <-> help & support ---------------- */
function showHelp(){ $('#chatView').hidden=true; $('#helpView').hidden=false; $('#help').classList.add('active'); $('#helpView .hscroll').scrollTop=0 }
function showChat(){ $('#helpView').hidden=true; $('#chatView').hidden=false; $('#help').classList.remove('active'); q.focus() }
$('#help').onclick=showHelp;
$('#helpBack').onclick=showChat;
document.querySelectorAll('#helpView .hchips button[data-q]').forEach(b=>b.onclick=()=>{showChat(); send(b.dataset.q)});
$('#helpUpload').onclick=()=>{showChat(); $('#file').click()};
renderHist(); welcome(); loadDocs();
{const p=new URLSearchParams(location.search).get('q'); if(p) send(p)}   // /?q=find a pasta recipe  -> opens with that message sent
</script>
</body>
</html>
