<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Nosh Assistant</title>
<link rel="icon" type="image/png" href="/static/img/favicon.png"><link rel="shortcut icon" href="/favicon.ico">
<style>
  :root{
    --side:#1c1a18; --side2:#2a2623; --orange:#f4511e; --orange2:#ff6a33;
    --bg:#fdf4ee; --bot:#f2e6e0; --me:#fbd5bf; --card:#fff; --line:#f3dccd;
    --font:Inter,"Segoe UI",system-ui,-apple-system,sans-serif; --ink:#1d1a17; --mut:#6f655d; --promo:#fbd9c5; --chip:#fde7da;
  }
  *{box-sizing:border-box;margin:0}
  html,body{height:100%}
  body{font-family:Inter,"Segoe UI",system-ui,-apple-system,sans-serif;color:var(--ink);background:var(--bg);display:flex;overflow:hidden}
  svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}

  /* ---------------- sidebar ---------------- */
  aside{width:214px;background:var(--side);color:#f4efea;display:flex;flex-direction:column;padding:21px 14px 15.5px;flex:none}
  .logo{padding:5px 7px 22.5px}
  .logo img{width:141px;display:block}
  .newchat{display:flex;align-items:center;gap:12px;background:var(--orange);color:#fff;border:0;border-radius:8.5px;padding:13px 19px;font:600 16.5px var(--font);cursor:pointer;width:100%;text-align:left}
  .newchat:hover{background:var(--orange2)}
  .nav{margin-top:19px;display:flex;flex-direction:column;gap:5px}
  .nav a,.nav button{display:flex;align-items:center;gap:12px;color:#f4efea;text-decoration:none;padding:10.5px 15.5px;white-space:nowrap;border-radius:8.5px;font:500 15.5px var(--font);background:none;border:0;cursor:pointer;text-align:left}
  .nav a:hover,.nav button:hover{background:var(--side2)}
  .sep{border-top:1px solid #38332f;margin:22.5px 7px 15.5px}
  .hist{background:var(--side2);border-radius:8.5px}
  .hist>button{display:flex;align-items:center;gap:12px;width:100%;padding:12px 15.5px;background:none;border:0;color:#f4efea;font:500 16.5px var(--font);cursor:pointer}
  .hist>button .chev{margin-left:auto;transition:transform .2s}
  .hist.open .chev{transform:rotate(180deg)}
  .hist ul{list-style:none;padding:0 7px 7px;display:none;max-height:226px;overflow:auto}
  .hist.open ul{display:block}
  .hist li{padding:8px 10.5px;border-radius:7px;font-size:12px;color:#d9d1c9;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .hist li:hover{background:#38332f}
  .hist li.empty{cursor:default;color:#8b8279}
  .grow{flex:1}
  .user{border-top:1px solid #38332f;padding-top:15.5px;display:flex;align-items:center;gap:10.5px;font-size:13px}
  .user .av{width:38.5px;height:38.5px;border-radius:50%;overflow:hidden;flex:none;background:#2a2623;box-shadow:0 0 0 2px #38332f}
  .user .av img{width:100%;height:100%;object-fit:cover;display:block}

  /* ---------------- main ---------------- */
  main{flex:1;min-width:0;display:flex;flex-direction:column;padding:0 22.5px 0 50.5px;max-width:1113.5px}
  header{padding:33px 0 10.5px}
  header h1{font-size:31.5px;font-weight:700;letter-spacing:-.5px;display:flex;align-items:center;gap:14px}
  .online{font-size:16.5px;font-weight:400;color:var(--ink);display:inline-flex;align-items:center;gap:8px}
  .online i{width:11.5px;height:11.5px;border-radius:50%;background:var(--orange);display:inline-block}
  header p{font-size:18.5px;color:var(--mut);margin-top:5px}
  #log{flex:1;overflow-y:auto;padding:12px 5px 8.5px 0;display:flex;flex-direction:column;gap:15.5px;scroll-behavior:smooth}
  #log::-webkit-scrollbar{width:7px}#log::-webkit-scrollbar-thumb{background:#ecd3c3;border-radius:7px}
  .row{display:flex;gap:17.5px;align-items:flex-start;max-width:783px}
  .row.me{align-self:flex-end;justify-content:flex-end}
  .avatar{width:47px;height:47px;border-radius:50%;background:#14110f;display:grid;place-items:center;flex:none}
  .avatar svg{width:24.5px;height:24.5px;fill:var(--orange);stroke:none}
  .bubble{background:var(--bot);border-radius:22.5px;padding:17.5px 22.5px;font-size:18.5px;line-height:1.42;white-space:pre-wrap;word-break:break-word;width:fit-content;max-width:100%}
  .bubble b{font-weight:700}
  .row.me .bubble{background:var(--me);border-radius:22.5px;padding:14px 24.5px}
  .bubble.small{font-size:14.5px}
  .stack{display:flex;flex-direction:column;gap:14px;min-width:0}

  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(163.5px,1fr));gap:12px;max-width:696px}
  .card{background:var(--card);border:1.5px solid var(--line);border-radius:15.5px;overflow:hidden;cursor:pointer;transition:transform .15s,box-shadow .15s;display:flex;flex-direction:column}
  .card:hover{transform:translateY(-2.5px);box-shadow:0 8.5px 21px rgba(244,81,30,.14)}
  .card img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;background:#f1e0d3}
  .card .t{padding:10.5px 12px 3.5px;font-size:15px;font-weight:700;line-height:1.25}
  .card .m{padding:3.5px 12px 7px;display:flex;gap:7px;align-items:center;flex-wrap:wrap;font-size:12px;color:#4a413a}
  .card .m span{display:inline-flex;align-items:center;gap:5px}
  .card .m svg{width:15px;height:15px;stroke:var(--orange)}
  .card .m em{width:1px;height:14px;background:#e4cdbf}
  .card .x{padding:0 12px 10.5px;font-size:11px;color:var(--mut);line-height:1.35}

  .note{font-size:11.5px;color:var(--mut);margin:-5px 0 0 3.5px}
  .chips{display:flex;flex-wrap:wrap;gap:10.5px;margin-left:64.5px}
  .chip{display:inline-flex;align-items:center;gap:8.5px;background:var(--chip);border:1.5px solid #f6c3a8;color:var(--ink);border-radius:26px;padding:9.5px 17.5px;font:500 15.5px var(--font);cursor:pointer}
  .chip svg{stroke:var(--orange);width:19px;height:19px}
  .chip:hover{background:#fcd6c2}
  .typing{display:flex;gap:5px;padding:7px 2px}
  .typing i{width:8px;height:8px;border-radius:50%;background:#bba79b;animation:b 1s infinite}
  .typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}
  @keyframes b{0%,60%,100%{transform:none;opacity:.5}30%{transform:translateY(-4.5px);opacity:1}}

  form{margin:8.5px 0 24.5px;max-width:783px}
  .inp{display:flex;align-items:center;background:#fff7f2;border:2px solid #f6d7c6;border-radius:35px;padding:8.5px 10.5px 8.5px 28px;box-shadow:0 3.5px 15.5px rgba(244,81,30,.07)}
  .inp:focus-within{border-color:#f6a37e}
  .inp input#q{flex:1;border:0;outline:0;background:transparent;font:400 18.5px var(--font);color:var(--ink);padding:8.5px 0}
  .inp input::placeholder{color:#8b7f76}
  .send{width:48.5px;height:48.5px;border-radius:50%;border:0;background:var(--orange);color:#fff;display:grid;place-items:center;cursor:pointer}
  .send:hover{background:var(--orange2)}
  .send svg{width:22.5px;height:22.5px;stroke:#fff;fill:#fff;stroke-width:1}

  /* ---------------- rich answers (markdown) ---------------- */
  .bubble.md{white-space:normal}
  .row:not(.me) .bubble p{text-align:justify;text-justify:inter-word;hyphens:auto;-webkit-hyphens:auto}
  .row:not(.me) .bubble p em{display:block;margin-top:.1em;font-size:.88em;line-height:1.5;color:#5c5047}
  .bubble p{margin:0 0 .65em}.bubble p:last-child{margin-bottom:0}
  .bubble ul,.bubble ol{margin:.2em 0 .7em;padding-left:1.35em}
  .bubble li>ul{margin:.25em 0 .35em}.bubble li{margin:.18em 0}
  .bubble h3,.bubble h4,.bubble h5{font-size:1.02em;margin:.9em 0 .35em;font-weight:700}
  .bubble h3{font-size:1.1em}
  .bubble strong{font-weight:700}
  .bubble code{background:#e9d9d0;border-radius:5px;padding:1px 5px;font:0.88em ui-monospace,Consolas,monospace}
  .bubble pre{background:#2a2623;color:#f4efea;border-radius:10.5px;padding:10.5px 12px;overflow:auto;margin:.5em 0;font-size:.82em}
  .bubble pre code{background:none;padding:0;color:inherit}
  .bubble blockquote{border-left:2.5px solid var(--orange);margin:.4em 0;padding:.1em 0 .1em .9em;color:#5a4f47}
  .bubble a{color:var(--orange);font-weight:600}
  .bubble hr{border:0;border-top:1px solid #e0c9bb;margin:.8em 0}
  .bubble .tw{overflow-x:auto;margin:.45em 0 .7em}
  .bubble table{border-collapse:collapse;font-size:.82em;min-width:60%;table-layout:auto}
  .bubble th,.bubble td{border:1px solid #e6cfc1;padding:6px 9.5px;text-align:left;vertical-align:top;word-break:normal;overflow-wrap:normal;hyphens:none}
  .bubble th:first-child,.bubble td:first-child{white-space:nowrap}
  .bubble th{background:#f9e3d6;font-weight:700}
  .bubble td{background:#fff9f5}
  sup.cite{display:inline-grid;place-items:center;min-width:16.5px;height:16.5px;border-radius:8.5px;background:#fcd9c5;color:#b83a0e;font:700 9.5px var(--font);margin:0 2px;vertical-align:2px;padding:0 3.5px}
  sup.cite.sql{background:#2a2623;color:#fff}
  .sources{display:flex;flex-wrap:wrap;gap:7px;align-items:center;font-size:11.5px;color:var(--mut)}
  .sources span{font-weight:600}
  .sources em{font-style:normal;display:inline-flex;align-items:center;gap:5px;background:#fff;border:1.5px solid var(--line);border-radius:17.5px;padding:3.5px 9.5px;color:#4a413a}
  .sources svg{width:13px;height:13px;stroke:var(--orange)}

  /* ---------------- attachments ---------------- */
  #docs{display:none;flex-wrap:wrap;gap:7px;max-width:783px;margin:0 0 8.5px}
  .dchip{display:inline-flex;align-items:center;gap:7px;background:#fff;border:1.5px solid #f6c3a8;border-radius:19px;padding:5px 7px 5px 10.5px;font-size:12px;max-width:261px}
  .dchip svg{width:15.5px;height:15.5px;stroke:var(--orange)}
  .dchip span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .dchip button{border:0;background:#fde7da;color:var(--orange);width:19px;height:19px;border-radius:50%;cursor:pointer;font-size:14px;line-height:1;display:grid;place-items:center}
  .attach{width:40px;height:40px;border-radius:50%;border:0;background:transparent;color:#8b7f76;display:grid;place-items:center;cursor:pointer;margin-left:-12px;margin-right:5px;flex:none}
  .attach:hover{background:#fde7da;color:var(--orange)}
  .attach svg{width:22.5px;height:22.5px}
  .send:disabled{opacity:.55;cursor:wait}
  #drop{position:fixed;inset:0;background:rgba(244,81,30,.12);border:3.5px dashed var(--orange);display:none;place-items:center;font:700 26px var(--font);color:var(--orange);z-index:50;pointer-events:none}
  #drop.on{display:grid}

  /* ---------------- help & support page ---------------- */
  [hidden]{display:none!important}
  .help .hscroll{flex:1;overflow-y:auto;padding:5px 7px 35px 0;max-width:783px}
  .help .hscroll::-webkit-scrollbar{width:7px}.help .hscroll::-webkit-scrollbar-thumb{background:#ecd3c3;border-radius:7px}
  .help section{margin:0 0 26px}
  .help h2{font-size:18.5px;font-weight:700;margin:0 0 12px;letter-spacing:-.2px}
  .hgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
  .hcard{display:flex;flex-direction:column;gap:5px;background:#fff;border:1.5px solid var(--line);border-radius:17.5px;padding:17.5px 19px;color:var(--ink);text-decoration:none;transition:transform .15s,box-shadow .15s}
  .hcard:hover{transform:translateY(-2.5px);box-shadow:0 8.5px 21px rgba(244,81,30,.14)}
  .hico{width:40px;height:40px;border-radius:12px;background:#fde7da;display:grid;place-items:center;margin-bottom:5px;flex:none}
  .hico svg{width:21px;height:21px;stroke:var(--orange)}
  .hico.s{width:36.5px;height:36.5px;margin:0}
  .hcard:nth-child(3) .hval{font-size:14px;font-weight:600;line-height:1.5}
  .hlabel{font-size:12px;color:var(--mut);font-weight:600}
  .hval{font-size:15.5px;font-weight:700;line-height:1.4}
  .hnote{display:flex;gap:12px;align-items:flex-start;background:var(--promo);border-radius:15.5px;padding:14px 17.5px;margin-top:12px;font-size:14.5px;line-height:1.5}
  .hnote svg{width:22.5px;height:22.5px;stroke:var(--orange);flex:none;margin-top:1px}
  .hnote a{color:var(--orange);font-weight:700;text-decoration:none}
  .hlist{display:flex;flex-direction:column;gap:8.5px}
  .hrow{display:flex;align-items:center;gap:14px;background:#fff;border:1.5px solid var(--line);border-radius:15.5px;padding:12px 15.5px;color:var(--ink);text-decoration:none;transition:border-color .15s,background .15s}
  .hrow:hover{border-color:#f6a37e;background:#fffaf6}
  .hrow>span:nth-child(2){flex:1;display:flex;flex-direction:column;gap:2px;font-size:15px}
  .hrow em{font-style:normal;color:var(--mut);font-size:12.5px}
  .hrow .go{width:17.5px;height:17.5px;stroke:#b3a79d;flex:none}
  .hsmall{font-size:12.5px;color:var(--mut);margin:8.5px 2px 0}
  .hchips{display:flex;flex-wrap:wrap;gap:8.5px;margin-top:10.5px}
  .hchips button{background:var(--chip);border:1.5px solid #f6c3a8;border-radius:26px;padding:8.5px 15.5px;font:500 14px var(--font);color:var(--ink);cursor:pointer}
  .hchips button:hover{background:#fcd6c2}
  .hback{display:inline-flex;align-items:center;gap:8.5px;background:var(--orange);color:#fff;border:0;border-radius:12px;padding:11.5px 19px;font:600 15px var(--font);cursor:pointer}
  .hback:hover{background:var(--orange2)}
  .hback svg{stroke:#fff;width:17.5px;height:17.5px}
  .nav .active{background:var(--side2)}


  @media (max-width:760px){
    aside{display:none}
    main{padding:0 12px}
    header h1{font-size:24.5px}header p{font-size:15px}
    .bubble{font-size:15px;padding:12px 15.5px}.avatar{width:36.5px;height:36.5px}.chips{margin-left:0}
  }

  /* ---------------- layout, scrolling & overflow (compact SaaS layout) ---------------- */
  html,body{height:100%;overflow:hidden}
  body{height:100vh;height:100dvh}
  aside{height:100vh;height:100dvh;overflow-y:auto;scrollbar-width:none}
  aside::-webkit-scrollbar{display:none}
  main{height:100vh;height:100dvh;min-height:0;overflow:hidden;position:relative}
  main>header{flex:none}
  #log{min-height:0;position:relative;overscroll-behavior:contain;scroll-behavior:auto;padding-bottom:14px;scrollbar-gutter:stable}
  .row{min-width:0}
  .stack{min-width:0;max-width:100%}
  .bubble{min-width:0;overflow-wrap:anywhere;word-break:normal}
  .bubble.md{overflow-wrap:break-word}
  .bubble .tw,.bubble pre{max-width:100%;overflow-x:auto}
  .bubble img{max-width:100%;height:auto}
  .bubble table{max-width:none}
  .cards{min-width:0}
  #docs,form{flex:none}
  form{position:relative;z-index:2;margin:6px 0 18px}
  .help .hscroll{min-height:0}
  .jump{position:absolute;left:50%;transform:translateX(-50%);bottom:96px;z-index:5;display:none;align-items:center;gap:7px;background:#fff;color:var(--orange);
        border:1.5px solid #f6c3a8;border-radius:22px;padding:7px 15px 7px 11px;font:600 13px var(--font);cursor:pointer;box-shadow:0 6px 18px rgba(0,0,0,.12)}
  .jump.on{display:inline-flex}
  .jump svg{width:16px;height:16px;stroke:var(--orange)}
  @media (max-height:820px){
    main>header{padding-top:22px}
    main>header h1{font-size:27px}
    main>header p{font-size:16px}
    .avatar{width:42px;height:42px}
  }

  /* ---------------- centred single-column layout (no right panel) ---------------- */
  main{max-width:none;padding:0 clamp(18px,3.5vw,56px)}
  main>header,form{width:100%;max-width:820px;margin-left:auto;margin-right:auto}
  main>header{padding-left:0;padding-right:0}
  #log{padding:10px max(6px,calc((100% - 820px)/2)) 14px}
  .row,.cards{max-width:100%}
  .cards{grid-template-columns:repeat(auto-fill,minmax(214px,1fr))}
  .chips{margin-left:60px}
  form{margin:6px auto 18px}
  .help .hscroll{width:100%;max-width:820px;margin:0 auto;padding-right:6px}
  .jump{bottom:92px}

  /* ---------------- composer & attachments ---------------- */
  .composer{background:#fff7f2;border:1.5px solid #f6d7c6;border-radius:24px;box-shadow:0 3px 14px rgba(244,81,30,.07);transition:border-color .15s,box-shadow .15s}
  .composer:focus-within{border-color:#f6a37e;box-shadow:0 4px 18px rgba(244,81,30,.12)}
  .composer .inp{border:0;border-radius:0;background:transparent;box-shadow:none;padding:7px 9px 7px 12px}
  .composer.has-docs .inp{padding-top:3px}
  #docs.tray{display:none;flex-wrap:wrap;gap:8px;padding:11px 12px 3px;margin:0;max-width:none;width:auto}
  .dchip{position:relative;display:flex;align-items:center;gap:9px;background:#fff;border:1.5px solid #f1ddd0;border-radius:13px;padding:7px 8px 7px 7px;min-width:0;max-width:264px;overflow:hidden;font-size:inherit}
  .dchip:hover{border-color:#f6b99c}
  .ft{flex:none;width:34px;height:34px;border-radius:9px;display:grid;place-items:center;font:800 10px var(--font);letter-spacing:.3px;color:#fff;overflow:visible}
  .ft.pdf{background:#e5484d}.ft.doc{background:#3b82f6}.ft.xls{background:#16a34a}.ft.txt{background:#78716c}.ft.json{background:#d97706}.ft.html{background:#8b5cf6}
  .dtxt{display:flex;flex-direction:column;min-width:0;line-height:1.25;overflow:visible;text-overflow:clip}
  .dtxt b{font:600 13px var(--font);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:178px}
  .dtxt i{font:normal 11.5px var(--font);color:var(--mut);white-space:nowrap}
  .dchip .x{flex:none;width:20px;height:20px;border:0;border-radius:50%;background:transparent;color:#9a8e84;cursor:pointer;display:grid;place-items:center;font-size:16px;line-height:1;padding:0}
  .dchip .x:hover{background:#fde7da;color:var(--orange)}
  .dchip.err{border-color:#f3b4b4;background:#fff5f5}
  .dchip.err .dtxt i{color:#c53030;white-space:normal;max-width:190px}
  .dchip .bar{position:absolute;left:0;right:0;bottom:0;height:3px;background:#f5e6dc;overflow:hidden}
  .dchip .bar u{display:block;height:100%;width:0;background:var(--orange);transition:width .15s;text-decoration:none}
  .dchip.read .bar u{width:40%!important;animation:slide 1.1s infinite ease-in-out}
  @keyframes slide{0%{margin-left:-40%}100%{margin-left:100%}}
  .attach{position:relative}
  .attach .cnt{position:absolute;top:-1px;right:-1px;min-width:16px;height:16px;border-radius:8px;background:var(--orange);color:#fff;font:700 10px var(--font);display:grid;place-items:center;padding:0 4px}
  .attach.on{color:var(--orange)}
  .attach:focus-visible,.dchip .x:focus-visible{outline:2px solid var(--orange);outline-offset:2px}
  #drop{background:rgba(253,244,238,.9);border:3px dashed var(--orange);backdrop-filter:blur(2px);font:inherit}
  .dropcard{display:flex;flex-direction:column;align-items:center;gap:6px;background:#fff;border-radius:22px;padding:26px 40px;box-shadow:0 14px 40px rgba(0,0,0,.12);text-align:center}
  .dropcard svg{width:36px;height:36px;stroke:var(--orange)}
  .dropcard b{font:700 20px var(--font);color:var(--ink)}
  .dropcard span{font:400 13.5px var(--font);color:var(--mut)}
  .bubble.md h5{font-size:1.06em;margin:1.05em 0 .4em;padding-bottom:.25em;border-bottom:1px solid #e6cfc1;color:#b83a0e}
  .bubble.md h3:first-child{font-size:1.25em;margin:.1em 0 .15em}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute"><defs>
  <symbol id="flame" viewBox="0 0 24 24"><path d="M13.2 1.5c.4 3.2 2.3 4.6 4 6.5 1.8 2 2.9 3.9 2.9 6.6A8 8 0 0 1 4 15.3c0-2.6 1.3-4.4 2.7-5.8.1 1.7.8 2.6 1.9 2.7 1.3.1 1.6-1.6.9-3.2-.9-2-.6-4.4 1.6-5.7.7-.4 1.5-1 2.1-1.8z"/></symbol>
  <symbol id="i-chat" viewBox="0 0 24 24"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.7-5A8.5 8.5 0 1 1 21 12z"/><circle cx="8.5" cy="12" r=".6"/><circle cx="12" cy="12" r=".6"/><circle cx="15.5" cy="12" r=".6"/></symbol>
  <symbol id="i-home" viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/><path d="M10 20v-5.5h4V20"/></symbol>
  <symbol id="i-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5"/><path d="M9.2 9.3a2.9 2.9 0 1 1 4.3 2.5c-.9.5-1.5 1.1-1.5 2.2"/><circle cx="12" cy="17.4" r=".5"/></symbol>
  <symbol id="i-hist" viewBox="0 0 24 24"><path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1L3.5 8.5"/><path d="M3.5 3.8v4.7h4.7"/><path d="M12 7.5V12l3 2"/></symbol>
  <symbol id="i-chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></symbol>
  <symbol id="i-sliders" viewBox="0 0 24 24"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></symbol>
  <symbol id="i-pot" viewBox="0 0 24 24"><path d="M5 9h14v9a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z"/><path d="M8 9V7a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M3 12h2M19 12h2"/></symbol>
  <symbol id="i-list" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8.5 9.5h7M8.5 12h7M8.5 14.5h4.5"/></symbol>
  <symbol id="i-leaf" viewBox="0 0 24 24"><path d="M5 19c0-8 5-13 15-14 0 9-4 14-12 14"/><path d="M5 19c3-5 6-7 10-9"/></symbol>
  <symbol id="i-chef" viewBox="0 0 24 24"><path d="M7 14.5a3.8 3.8 0 0 1-.6-7.5 4.2 4.2 0 0 1 7.9-1.2 3.9 3.9 0 0 1 3.7 4.6 3.5 3.5 0 0 1-1.5 4.1"/><path d="M7 14.5V20h10v-5.5"/><path d="M7 17.5h10"/></symbol>
  <symbol id="i-star" viewBox="0 0 24 24"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></symbol>
  <symbol id="i-clip" viewBox="0 0 24 24"><path d="m21 11.5-8.6 8.6a5.5 5.5 0 0 1-7.8-7.8l9-9a3.7 3.7 0 0 1 5.2 5.2l-9 9a1.8 1.8 0 0 1-2.6-2.6l8.4-8.4"/></symbol>
  <symbol id="i-doc" viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></symbol>
  <symbol id="i-table" viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M3.5 10h17M3.5 15h17M10 4.5v15"/></symbol>
  <symbol id="i-phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/></symbol>
  <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/></symbol>
  <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11.5a7 7 0 0 0-14 0C5 14.800 12 21 12 21z"/><circle cx="12" cy="9.500" r="2.500"/></symbol>
  <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.500 2"/></symbol>
  <symbol id="i-wifi" viewBox="0 0 24 24"><path d="M2.500 9a14 14 0 0 1 19 0M5.500 12.500a9.500 9.500 0 0 1 13 0M8.700 16a5 5 0 0 1 6.600 0"/><circle cx="12" cy="19.500" r=".6"/></symbol>
  <symbol id="i-tool" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9A6 6 0 0 1 17.900 2.500z"/></symbol>
  <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 4.500 6v5.500c0 4.500 3 8 7.500 9.500 4.500-1.500 7.500-5 7.500-9.500V6z"/><path d="m8.800 12 2.200 2.200 4.200-4.400"/></symbol>
  <symbol id="i-out" viewBox="0 0 24 24"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></symbol>
  <symbol id="i-down" viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6"/></symbol>
  <symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 3 5 13.5h6L10 21l8-10.5h-6z"/></symbol>
</defs></svg>

<aside>
  <div class="logo"><img src="/static/img/logo-footer.png" alt="NOSH"></div>
  <button class="newchat" id="new"><svg><use href="#i-chat"/></svg>New chat</button>
  <nav class="nav">
    <a href="https://www.letsnosh.io/" target="_blank" rel="noopener"><svg><use href="#i-home"/></svg>My Nosh</a>
    <button id="help"><svg><use href="#i-help"/></svg>Help &amp; Support</button>
  </nav>
  <div class="sep"></div>
  <div class="hist" id="hist">
    <button id="histBtn"><svg><use href="#i-hist"/></svg>History<svg class="chev"><use href="#i-chev"/></svg></button>
    <ul id="histList"></ul>
  </div>
  <div class="grow"></div>
  <div class="user"><div class="av"><img src="/static/img/avatar.jpg" alt="Uzair Meran Khan"></div><span>Uzair Meran Khan</span></div>
</aside>

<main id="chatView">
  <header>
    <h1>Nosh Assistant <span class="online"><i></i>Online</span></h1>
    <p>Here to make everyday cooking effortless</p>
  </header>
  <div id="log"></div>
  <button class="jump" id="jump" type="button"><svg><use href="#i-down"/></svg>Latest</button>
  <form id="f">
    <div class="composer" id="composer">
      <div id="docs" class="tray"></div>
      <div class="inp">
        <button class="attach" id="attach" type="button" aria-label="Attach a document" title="Attach PDF, Word, Excel, CSV, text or JSON files (or drag them in)"><svg><use href="#i-clip"/></svg><b class="cnt" hidden></b></button>
        <input id="q" autocomplete="off" placeholder="Ask Nosh anything about recipes, cooking, or your documents..." autofocus>
        <button class="send" aria-label="Send"><svg viewBox="0 0 24 24"><path d="M21.5 3 2.8 10.6l6.5 2.5 2.6 6.6zM9.3 13.1 21.5 3"/></svg></button>
      </div>
    </div>
    <input type="file" id="file" multiple hidden accept=".pdf,.docx,.txt,.md,.csv,.tsv,.xlsx,.json,.jsonl,.html,.htm,.rst,.log">
  </form>
  <div id="drop"><div class="dropcard"><svg><use href="#i-clip"/></svg><b>Drop files to add them to the chat</b><span>PDF, Word, Excel, CSV, TXT, JSON or HTML - up to 40 MB each</span></div></div>

</main>

<main id="helpView" class="help" hidden>
  <header>
    <h1>Help &amp; Support</h1>
    <p>We're here whenever your Nosh needs a hand</p>
  </header>
  <div class="hscroll">
    <section>
      <h2>Contact Nosh Robotics</h2>
      <div class="hgrid">
        <a class="hcard" href="tel:+916366377918">
          <span class="hico"><svg><use href="#i-phone"/></svg></span>
          <span class="hlabel">Phone support</span>
          <span class="hval">+91 63663 77918</span>
        </a>
        <a class="hcard" href="mailto:hello@euphotic.io">
          <span class="hico"><svg><use href="#i-mail"/></svg></span>
          <span class="hlabel">Email support</span>
          <span class="hval">hello@euphotic.io</span>
        </a>
        <a class="hcard" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&amp;query=Nosh+Robotics+Private+Limited+7th+Main+Rd+BEML+Layout+6th+Stage+Brookefield+Bengaluru+560066">
          <span class="hico"><svg><use href="#i-pin"/></svg></span>
          <span class="hlabel">Office address</span>
